# QuizWiz Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER_CONNECT=connect@quizwiz.co.in
SMTP_USER_SUPPORT=support@quizwiz.co.in
# Address that receives enrollment and ambassador application notifications
ADMIN_EMAIL=admin@quizwiz.co.in
SMTP_PASS=your_email_password_here

# Optional: Google Analytics 4 Measurement ID
GA_MEASUREMENT_ID=

# Optional: Custom Secret Key for 1-Click Lead CSV Downloader (/admin-export?key=...)
ADMIN_EXPORT_KEY=QuizwizAdmin2026
